# Dotfiles symlink manifest
# Format: <action> <source-relative-to-repo> <target-relative-to-home>
#
# Actions:
#   dir   - symlink entire directory
#   file  - symlink single file
#   glob  - expand wildcard pattern (e.g., *.conf)
#   copy  - copy file instead of symlink (local file has priority)
#   skip  - explicit exclusion (files exist in repo but not managed)
#
# Notes:
#   - Paths are relative to $REPO_ROOT (source) and $HOME (target)
#   - Comments start with #
#   - Empty lines are ignored
#   - Tab-separated fields

# --- Omarchy ---
dir	omarchy/home/config/omarchy/themes/tokyo-night-autana	.config/omarchy/themes/tokyo-night-autana

# --- Hyprland ---
glob	omarchy/home/config/hypr/*.conf	.config/hypr/

# -- Waybar ---
file	omarchy/home/config/waybar/config.jsonc	.config/waybar/config.jsonc

# --- Neovim ---
file	omarchy/home/config/nvim/lazyvim.json	.config/nvim/lazyvim.json
file	omarchy/home/config/nvim/lua/config/autocmds.lua	.config/nvim/lua/config/autocmds.lua
file	omarchy/home/config/nvim/lua/config/keymaps.lua	.config/nvim/lua/config/keymaps.lua
file	omarchy/home/config/nvim/lua/config/options.lua	.config/nvim/lua/config/options.lua
file	omarchy/home/config/nvim/lua/plugins/editorconfig.lua	.config/nvim/lua/plugins/editorconfig.lua
file	omarchy/home/config/nvim/lua/plugins/opencode.lua	.config/nvim/lua/plugins/opencode.lua
file	omarchy/home/config/nvim/lua/plugins/render-markdown.lua	.config/nvim/lua/plugins/render-markdown.lua
file	omarchy/home/config/nvim/lua/plugins/snacks-paths.lua	.config/nvim/lua/plugins/snacks-paths.lua
dir	omarchy/home/config/nvim/spell	.config/nvim/spell

# --- Bash ---
dir	omarchy/home/config/bash	.config/bash
file	omarchy/home/bashrc	.bashrc

# --- Starship ---
file	omarchy/home/config/starship.toml	.config/starship.toml

# --- Mise ---
dir	omarchy/home/config/mise	.config/mise

# --- Alacritty ---
file	omarchy/home/config/alacritty/alacritty.toml	.config/alacritty/alacritty.toml

# --- Tmux ---
dir	omarchy/home/config/tmux	.config/tmux

# --- Zellij ---
dir	omarchy/home/config/zellij	.config/zellij

# --- SSH ---
copy	omarchy/home/ssh/config	.ssh/config

# --- Explicit exclusions ---
file	omarchy/home/local/bin/monitor	.local/bin/monitor
