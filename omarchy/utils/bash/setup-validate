#!/usr/bin/env bash

set -euo pipefail

DRY_RUN="${DOTFILES_DRY_RUN:-0}"

usage() {
    cat <<EOF
Usage: $0 [--dry-run] [--help]

Check Omarchy 4, reload Hyprland, and fail on configuration errors.
EOF
}
log() { echo "[setup-validate] $*"; }
fail() { echo "[setup-validate] ERROR: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) fail "unknown option: $1" ;;
    esac
done

command -v omarchy >/dev/null 2>&1 || fail "required command 'omarchy' is not on PATH"
omarchy_version="$(omarchy version 2>/dev/null)" || fail "could not determine the installed Omarchy version"
[[ "$omarchy_version" =~ ^4\. ]] || fail "Omarchy 4.x is required; found: $omarchy_version"
command -v hyprctl >/dev/null 2>&1 || fail "required command 'hyprctl' is not on PATH"
command -v herdr >/dev/null 2>&1 || fail "required command 'herdr' is not on PATH"

if (( DRY_RUN )); then
    log "[dry-run] would verify: Omarchy $omarchy_version"
    log "[dry-run] would run: hyprctl reload"
    log "[dry-run] would run: hyprctl configerrors"
    log "[dry-run] would run: herdr config check"
    exit 0
fi

log "Reloading Hyprland"
hyprctl reload
log "Checking Hyprland configuration"
hyprctl configerrors
log "Checking Herdr configuration"
herdr config check
