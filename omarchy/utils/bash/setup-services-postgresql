#!/usr/bin/env bash

# Arch PostgreSQL contract: postgresql.service runs postgres:postgres with
# PGROOT=/var/lib/postgres and creates /run/postgresql itself.
set -euo pipefail

REPO_ROOT="${DOTFILES_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)}"
BACKUP_DIR="${DOTFILES_BACKUP_DIR:-$REPO_ROOT/backup/$(date -u +%Y%m%dT%H%M%SZ)}"
DRY_RUN="${DOTFILES_DRY_RUN:-0}"
NON_INTERACTIVE=0
DATA_DIR="${POSTGRES_DATA_DIR:-/var/lib/postgres/data}"
RUNTIME_DIR="${POSTGRES_RUNTIME_DIR:-/run/postgresql}"
SOURCE="$REPO_ROOT/omarchy/etc/postgresql/pg_hba.conf"
TARGET="$DATA_DIR/pg_hba.conf"

log() { echo "[setup-services-postgresql] $*"; }
fail() { echo "[setup-services-postgresql] ERROR: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --non-interactive) NON_INTERACTIVE=1; shift ;;
        *) fail "unknown option: $1" ;;
    esac
done

unit_enabled_before=0
unit_active_before=0
config_existed=0
backup=""
changed=0

unit_was_enabled() { sudo systemctl is-enabled --quiet postgresql.service; }
unit_was_active() { sudo systemctl is-active --quiet postgresql.service; }

restore_unit_state() {
    local enabled_now=0 active_now=0
    if unit_was_enabled; then enabled_now=1; fi
    if unit_was_active; then active_now=1; fi
    if (( unit_active_before )); then
        (( active_now )) || sudo systemctl start postgresql.service || log "Recovery ERROR: could not restart postgresql.service"
    elif (( active_now )); then
        sudo systemctl stop postgresql.service || log "Recovery ERROR: could not stop postgresql.service"
    fi
    if (( unit_enabled_before )); then
        (( enabled_now )) || sudo systemctl enable postgresql.service || log "Recovery ERROR: could not re-enable postgresql.service"
    elif (( enabled_now )); then
        sudo systemctl disable postgresql.service || log "Recovery ERROR: could not disable postgresql.service"
    fi
}

recover() {
    local reason="$1"
    if (( changed )); then
        if (( config_existed )); then
            log "Recovery: restoring $TARGET from $backup"
            if sudo cp -a -- "$backup" "$TARGET"; then
                if unit_was_active; then
                    sudo systemctl reload postgresql.service || log "Recovery ERROR: could not reload restored PostgreSQL configuration"
                fi
            else
                log "Recovery ERROR: could not restore $TARGET"
            fi
        else
            log "Recovery: removing newly installed $TARGET"
            sudo rm -f -- "$TARGET" || log "Recovery ERROR: could not remove $TARGET"
        fi
    fi
    restore_unit_state
    fail "$reason"
}

ensure_localhost_config() {
    local value
    value="$(sudo -u postgres postgres -D "$DATA_DIR" -C listen_addresses)" || fail "could not determine PostgreSQL listen_addresses"
    [[ "$value" == localhost ]] || fail "PostgreSQL listen_addresses is not localhost: $value"
}

ensure_service() {
    sudo systemctl is-enabled --quiet postgresql.service || sudo systemctl enable postgresql.service || recover "could not enable postgresql.service"
    sudo systemctl is-active --quiet postgresql.service || sudo systemctl start postgresql.service || recover "could not start postgresql.service"
}

install_hba() {
    if sudo cmp -s -- "$SOURCE" "$TARGET" 2>/dev/null; then
        log "Unchanged: $TARGET"
        return
    fi
    if sudo test -e "$TARGET"; then
        config_existed=1
        backup="$BACKUP_DIR${TARGET}"
        log "Backing up: $TARGET -> $backup"
        mkdir -p "$(dirname -- "$backup")"
        sudo cp -a -- "$TARGET" "$backup" || fail "could not back up $TARGET"
    fi
    log "Installing configuration: $TARGET"
    sudo install -o postgres -g postgres -m 0600 -- "$SOURCE" "$TARGET" || fail "could not install $TARGET"
    changed=1
}

[[ -f "$SOURCE" ]] || fail "configuration source not found: $SOURCE"
if (( DRY_RUN )); then
    log "[dry-run] would initialize PostgreSQL only if $DATA_DIR is absent or empty"
    log "[dry-run] would install configuration: $TARGET"
    log "[dry-run] would enable and start postgresql.service"
    log "[dry-run] would reload postgresql.service if configuration changed"
    log "[dry-run] would validate PostgreSQL through $RUNTIME_DIR and localhost TCP"
    exit 0
fi

for command in sudo initdb postgres systemctl pg_isready psql; do command -v "$command" >/dev/null 2>&1 || fail "$command is required; run --deps first"; done
if sudo test -f "$DATA_DIR/PG_VERSION"; then
    sudo test -d "$DATA_DIR/base" || fail "PostgreSQL data directory is incomplete: $DATA_DIR"
    ensure_localhost_config
    log "PostgreSQL cluster is initialized"
elif sudo test -e "$DATA_DIR" && [[ -n "$(sudo find "$DATA_DIR" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
    fail "PostgreSQL data directory is not empty and is missing PG_VERSION: $DATA_DIR"
else
    log "Initializing PostgreSQL cluster"
    sudo install -d -o postgres -g postgres -m 0700 "$DATA_DIR"
    sudo -u postgres initdb --locale=C.UTF-8 --encoding=UTF8 --auth-local=peer --auth-host=scram-sha-256 -D "$DATA_DIR" || fail "could not initialize PostgreSQL cluster"
fi

if unit_was_enabled; then unit_enabled_before=1; fi
if unit_was_active; then unit_active_before=1; fi
install_hba
ensure_service
if (( changed )); then
    sudo systemctl reload postgresql.service || recover "could not reload postgresql.service"
fi
sudo -u postgres pg_isready -h "$RUNTIME_DIR" -q || recover "PostgreSQL is not ready"
sudo -u postgres psql -h "$RUNTIME_DIR" -d postgres --set ON_ERROR_STOP=1 --tuples-only --command 'SELECT 1;' >/dev/null || recover "PostgreSQL local query failed"
[[ "$(sudo -u postgres psql -h "$RUNTIME_DIR" -d postgres --tuples-only --no-align --command 'SHOW listen_addresses;')" == localhost ]] || recover "PostgreSQL is not restricted to localhost"
log "PostgreSQL is ready"

if (( !NON_INTERACTIVE )) && [[ -t 0 ]]; then
    read -r -p "Set a password for the PostgreSQL postgres role? [y/N] " answer
    case "$answer" in
        y|Y|yes|YES)
            read -r -s -p "PostgreSQL password: " password; printf '\n'
            read -r -s -p "Confirm PostgreSQL password: " confirmation; printf '\n'
            [[ -n "$password" ]] || fail "password cannot be empty"
            [[ "$password" == "$confirmation" ]] || fail "passwords do not match"
            escaped_password="${password//\'/\'\'}"
            printf "ALTER ROLE postgres WITH PASSWORD '%s';\n" "$escaped_password" \
                | sudo -u postgres psql -h "$RUNTIME_DIR" -d postgres --set ON_ERROR_STOP=1 >/dev/null \
                || fail "could not update the postgres role password"
            unset password confirmation escaped_password
            log "PostgreSQL postgres role password updated"
            ;;
    esac
fi
