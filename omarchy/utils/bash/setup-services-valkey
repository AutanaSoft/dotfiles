#!/usr/bin/env bash

# Arch valkey.service runs as valkey:valkey and supplies /run/valkey.
set -euo pipefail

REPO_ROOT="${DOTFILES_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)}"
BACKUP_DIR="${DOTFILES_BACKUP_DIR:-$REPO_ROOT/backup/$(date -u +%Y%m%dT%H%M%SZ)}"
DRY_RUN="${DOTFILES_DRY_RUN:-0}"
NON_INTERACTIVE=0
SOURCE="$REPO_ROOT/omarchy/etc/valkey/valkey.conf"
TARGET="${VALKEY_CONFIG:-/etc/valkey/valkey.conf}"
SOCKET="${VALKEY_SOCKET:-/run/valkey/valkey.sock}"

log() { echo "[setup-services-valkey] $*"; }
fail() { echo "[setup-services-valkey] ERROR: $*" >&2; exit 1; }
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --non-interactive) NON_INTERACTIVE=1; shift ;;
        *) fail "unknown option: $1" ;;
    esac
done

unit_enabled_before=0
unit_active_before=0
config_existed=0
backup=""
changed=0

unit_was_enabled() { sudo systemctl is-enabled --quiet valkey.service; }
unit_was_active() { sudo systemctl is-active --quiet valkey.service; }

restore_unit_state() {
    local enabled_now=0 active_now=0
    if unit_was_enabled; then enabled_now=1; fi
    if unit_was_active; then active_now=1; fi
    if (( unit_active_before )); then
        (( active_now )) || sudo systemctl start valkey.service || log "Recovery ERROR: could not restart valkey.service"
    elif (( active_now )); then
        sudo systemctl stop valkey.service || log "Recovery ERROR: could not stop valkey.service"
    fi
    if (( unit_enabled_before )); then
        (( enabled_now )) || sudo systemctl enable valkey.service || log "Recovery ERROR: could not re-enable valkey.service"
    elif (( enabled_now )); then
        sudo systemctl disable valkey.service || log "Recovery ERROR: could not disable valkey.service"
    fi
}

recover() {
    local reason="$1"
    if (( changed )); then
        if (( config_existed )); then
            log "Recovery: restoring $TARGET from $backup"
            if sudo cp -a -- "$backup" "$TARGET"; then
                if unit_was_active; then
                    sudo systemctl restart valkey.service || log "Recovery ERROR: could not restart Valkey with restored configuration"
                fi
            else
                log "Recovery ERROR: could not restore $TARGET"
            fi
        else
            log "Recovery: removing newly installed $TARGET"
            sudo rm -f -- "$TARGET" || log "Recovery ERROR: could not remove $TARGET"
        fi
    fi
    restore_unit_state
    fail "$reason"
}

install_config() {
    if sudo cmp -s -- "$SOURCE" "$TARGET" 2>/dev/null; then
        log "Unchanged: $TARGET"
        return
    fi
    if sudo test -e "$TARGET"; then
        config_existed=1
        backup="$BACKUP_DIR${TARGET}"
        log "Backing up: $TARGET -> $backup"
        mkdir -p "$(dirname -- "$backup")"
        sudo cp -a -- "$TARGET" "$backup" || fail "could not back up $TARGET"
    fi
    log "Installing configuration: $TARGET"
    sudo install -o root -g root -m 0644 "$SOURCE" "$TARGET" || fail "could not install $TARGET"
    changed=1
}

ensure_service() {
    sudo systemctl is-enabled --quiet valkey.service || sudo systemctl enable valkey.service || recover "could not enable valkey.service"
    sudo systemctl is-active --quiet valkey.service || sudo systemctl start valkey.service || recover "could not start valkey.service"
}

validate_loopback_listener() {
    local line
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        [[ "$line" == *"127.0.0.1:6379"* || "$line" == *"[::1]:6379"* || "$line" == *"::1:6379"* ]] || return 1
    done < <(ss -ltnH 'sport = :6379')
    return 0
}

[[ -f "$SOURCE" ]] || fail "configuration source not found: $SOURCE"
if (( DRY_RUN )); then
    log "[dry-run] would verify valkey user and group"
    log "[dry-run] would ask before adding $USER to valkey only in an interactive run"
    log "[dry-run] would install configuration: $TARGET"
    log "[dry-run] would enable and start valkey.service"
    log "[dry-run] would restart valkey.service if configuration changed"
    log "[dry-run] would validate TCP, $SOCKET, and loopback-only port 6379"
    exit 0
fi

for command in sudo systemctl valkey-cli getent id ss; do command -v "$command" >/dev/null 2>&1 || fail "$command is required; run --deps first"; done
getent passwd valkey >/dev/null || fail "valkey user is missing; run --deps first"
getent group valkey >/dev/null || fail "valkey group is missing; run --deps first"
if [[ " $(id -nG) " != *" valkey "* ]] && (( !NON_INTERACTIVE )) && [[ -t 0 ]]; then
    read -r -p "Add $USER to the valkey group for socket access? [y/N] " answer
    case "$answer" in
        y|Y|yes|YES)
            sudo usermod -aG valkey "$USER" || fail "could not add $USER to valkey"
            log "Added $USER to valkey; start a new session or run 'newgrp valkey' in a terminal."
            ;;
    esac
fi

if unit_was_enabled; then unit_enabled_before=1; fi
if unit_was_active; then unit_active_before=1; fi
install_config
ensure_service
(( !changed )) || sudo systemctl restart valkey.service || recover "could not restart valkey.service"
[[ "$(valkey-cli -h 127.0.0.1 -p 6379 ping)" == PONG ]] || recover "Valkey TCP is not ready"
if [[ " $(id -nG) " == *" valkey "* ]]; then
    [[ "$(valkey-cli -s "$SOCKET" ping)" == PONG ]] || recover "Valkey socket is not ready"
else
    log "Socket validation skipped: current session is not in valkey; start a new session after enrollment."
fi
validate_loopback_listener || recover "Valkey port 6379 is exposed beyond loopback"
log "Valkey is ready"
