#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="${DOTFILES_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)}"
DRY_RUN="${DOTFILES_DRY_RUN:-0}"
NON_INTERACTIVE=0

usage() {
    cat <<EOF2
Usage: $0 [--dry-run] [--non-interactive] [--help]

Configure keyd and the Omarchy WireGuard boot service.
WireGuard is enabled only when /etc/wireguard/wg0.conf is a regular, non-symlink file;
the tunnel is never started by this helper.
EOF2
}
fail() { echo "[setup-services] ERROR: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --non-interactive) NON_INTERACTIVE=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) fail "unknown option: $1" ;;
    esac
done

args=()
(( DRY_RUN )) && args+=(--dry-run)
(( NON_INTERACTIVE )) && args+=(--non-interactive)
for helper in setup-services-input setup-services-wireguard; do
    path="$REPO_ROOT/omarchy/utils/bash/$helper"
    [[ -x "$path" ]] || fail "helper is missing or not executable: $path"
    "$path" "${args[@]}"
done
