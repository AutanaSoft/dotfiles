#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="${DOTFILES_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)}"
DRY_RUN="${DOTFILES_DRY_RUN:-0}"
BACKUP_DIR="${DOTFILES_BACKUP_DIR:-$REPO_ROOT/backup/$(date -u +%Y%m%dT%H%M%SZ)}"

usage() {
    cat <<EOF
Usage: $0 [--dry-run] [--help]

Apply the Omarchy user dotfiles manifest, preserving local targets in backups.
This helper does not install packages, fonts, services, locale, or session changes.
EOF
}
log() { echo "[setup-dots] $*"; }
fail() { echo "[setup-dots] ERROR: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --non-interactive) shift ;;
        --help|-h) usage; exit 0 ;;
        *) fail "unknown option: $1" ;;
    esac
done

backup_target() {
    local target="$1" rel backup_path suffix=1
    if [[ "$target" == "$HOME"/* ]]; then
        rel="${target#"$HOME"/}"
    else
        rel="${target//\//_}"
        rel="${rel#_}"
    fi
    backup_path="$BACKUP_DIR/$rel"
    while [[ -e "$backup_path" || -L "$backup_path" ]]; do
        backup_path="$BACKUP_DIR/$rel.$suffix"
        suffix=$((suffix + 1))
    done
    printf '%s\n' "$backup_path"
}

prepare_parent() {
    local parent="$1"
    [[ -z "$parent" || "$parent" == / || ! -e "$parent" && ! -L "$parent" ]] && return 0
    [[ -d "$parent" && ! -L "$parent" ]] && return 0
    if [[ -L "$parent" && ! -e "$parent" ]]; then
        log "Removing stale parent symlink: $parent"
        (( DRY_RUN )) || rm -- "$parent"
        return 0
    fi
    fail "parent path is not a regular directory: $parent"
}

ensure_symlink() {
    local source="$1" target="$2" stamp="$3" backup
    [[ -e "$source" || -L "$source" ]] || fail "source does not exist: $source"
    if [[ -L "$target" && "$(readlink -f -- "$target" 2>/dev/null || true)" == "$(readlink -f -- "$source" 2>/dev/null || true)" ]]; then
        log "Already linked: $target"
        return 0
    fi
    prepare_parent "$(dirname -- "$target")"
    if [[ -L "$target" ]]; then
        log "Removing stale target symlink: $target"
        (( DRY_RUN )) || rm -- "$target"
    elif [[ -e "$target" ]]; then
        backup="$(backup_target "$target")"
        log "Backing up existing target: $target -> $backup"
        if (( !DRY_RUN )); then mkdir -p "$(dirname -- "$backup")"; mv -- "$target" "$backup"; fi
    fi
    log "Creating symlink: $target -> $source"
    if (( !DRY_RUN )); then mkdir -p "$(dirname -- "$target")"; ln -sfn -- "$source" "$target"; fi
}

copy_file() {
    local source="$1" target="$2"
    [[ -e "$source" || -L "$source" ]] || { log "Skipping missing source: $source"; return; }
    if [[ -e "$target" || -L "$target" ]]; then
        log "Skipping copy: $target already exists"
        return
    fi
    log "Copying: $source -> $target"
    if (( !DRY_RUN )); then mkdir -p "$(dirname -- "$target")"; cp -- "$source" "$target"; fi
}

require_omarchy_4() {
    local version

    command -v omarchy >/dev/null 2>&1 || fail "required command 'omarchy' is not on PATH"
    version="$(omarchy version 2>/dev/null)" || fail "could not determine the installed Omarchy version"
    [[ "$version" =~ ^4\. ]] || fail "Omarchy 4.x is required; found: $version"
}

apply_manifest() {
    local manifest="$REPO_ROOT/omarchy/dots-manifest" action source target expanded
    [[ -f "$manifest" ]] || fail "manifest not found: $manifest"
    while IFS=$'\t' read -r action source target; do
        [[ -z "$action" || "$action" =~ ^[[:space:]]*# ]] && continue
        action="$(xargs <<<"$action")"; source="$(xargs <<<"$source")"; target="$(xargs <<<"$target")"
        case "$action" in
            dir|file) ensure_symlink "$REPO_ROOT/$source" "$HOME/$target" "" ;;
            glob)
                target="${target%/}"
                for expanded in $REPO_ROOT/$source; do
                    [[ -e "$expanded" ]] && ensure_symlink "$expanded" "$HOME/$target/$(basename -- "$expanded")" ""
                done
                ;;
            copy) copy_file "$REPO_ROOT/$source" "$HOME/$target" ;;
            skip) log "Skipping explicit exclusion: $source" ;;
            *) fail "unknown manifest action: $action" ;;
        esac
    done < "$manifest"
}

activate_monitor_plugin() {
    local plugins monitor_enabled power_enabled attempt
    if (( DRY_RUN )); then
        log "Would rescan plugins with omarchy-shell shell rescanPlugins"
        log "Would check enabled plugins and enable lcardenas.monitor on right before omarchy.power (or on right if absent)"
        return 0
    fi

    command -v omarchy-shell >/dev/null 2>&1 || fail "omarchy-shell is required; start the graphical shell and rerun setup-dots"
    omarchy-shell shell ping >/dev/null || fail "Omarchy shell unavailable; start the graphical shell and rerun setup-dots"
    omarchy-shell shell rescanPlugins || fail "Could not rescan Omarchy plugins; start the graphical shell and rerun setup-dots"
    # The rescan IPC returns before the registry's scan Process exits.
    for ((attempt = 1; attempt <= 15; attempt++)); do
        plugins="$(omarchy-shell shell listPlugins)" || fail "Could not list Omarchy plugins; start the graphical shell and rerun setup-dots"
        if jq -e 'type == "array" and any(.[]; .id == "lcardenas.monitor")' <<<"$plugins" >/dev/null; then
            break
        fi
        (( attempt < 15 )) || fail "lcardenas.monitor not discovered; verify its manifest and rerun setup-dots with the shell running"
        sleep 0.1
    done
    monitor_enabled="$(jq -r 'any(.[]; .id == "lcardenas.monitor" and .enabled == true)' <<<"$plugins")"
    if [[ "$monitor_enabled" == true ]]; then
        log "lcardenas.monitor already enabled; preserving layout"
        return 0
    fi
    power_enabled="$(jq -r 'any(.[]; .id == "omarchy.power" and .enabled == true)' <<<"$plugins")"
    if [[ "$power_enabled" == true ]]; then
        omarchy plugin enable lcardenas.monitor --section right --before omarchy.power ||
            fail "Could not enable lcardenas.monitor before omarchy.power; check the shell layout and rerun setup-dots"
    else
        log "omarchy.power absent; adding monitor to the right section"
        omarchy plugin enable lcardenas.monitor --section right ||
            fail "Could not enable lcardenas.monitor on right; check the shell and rerun setup-dots"
    fi
}

remove_obsolete_monitor_link() {
    local target="$HOME/.local/bin/monitor" obsolete="$REPO_ROOT/omarchy/home/local/bin/monitor"
    if [[ -L "$target" && "$(readlink -- "$target")" == "$obsolete" ]]; then
        log "Removing obsolete monitor symlink: $target"
        if (( !DRY_RUN )); then rm -- "$target"; fi
    fi
    return 0
}

require_omarchy_4
log "Repo root: $REPO_ROOT"
(( DRY_RUN )) && log "Mode: DRY-RUN (no user changes)"
apply_manifest
activate_monitor_plugin
remove_obsolete_monitor_link
log "User dotfiles complete."
