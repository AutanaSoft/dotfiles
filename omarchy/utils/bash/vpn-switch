#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: vpn-switch {wg0|wg1}\nSwitch between WireGuard profiles without changing boot enablement.\n'
}
fail() { printf 'vpn-switch: %s\n' "$*" >&2; exit 1; }
state() { systemctl show --property=ActiveState --value "wg-quick@$1.service"; }
switch_profile() {
  local target="$1" other=wg0 target_state other_state value current_target_state
  [[ "$target" == wg0 ]] && other=wg1
  target_state="$(state "$target")" || fail "cannot read $target service state"
  other_state="$(state "$other")" || fail "cannot read $other service state"
  for value in "$target_state" "$other_state"; do
    case "$value" in active|inactive|failed) ;; *) fail "service is in unexpected state: $value" ;; esac
  done
  if [[ "$target_state" == active && "$other_state" == active ]]; then
    fail 'both profiles are active; resolve the conflict manually'
  fi
  if [[ "$target_state" == active ]]; then
    printf 'vpn-switch: %s is already active\n' "$target"
    return 0
  fi
  if [[ "$other_state" == active ]]; then
    systemctl stop "wg-quick@$other.service" || fail "could not stop $other; $target was not started"
  fi
  if ! systemctl start "wg-quick@$target.service"; then
    printf 'vpn-switch: could not start %s\n' "$target" >&2
    if [[ "$other_state" == active ]]; then
      current_target_state="$(state "$target")" || fail "cannot verify $target state; $other was not restored"
      case "$current_target_state" in
        inactive|failed) ;;
        *) fail "$target is $current_target_state after failed start; $other was not restored" ;;
      esac
      if systemctl start "wg-quick@$other.service"; then
        printf 'vpn-switch: restored %s\n' "$other" >&2
      else
        printf 'vpn-switch: could not restore %s; inspect both services\n' "$other" >&2
      fi
    fi
    return 1
  fi
  printf 'vpn-switch: %s is active\n' "$target"
}

if [[ $# == 1 && ( $1 == --help || $1 == -h ) ]]; then usage; exit 0; fi
if [[ $# != 1 || ( $1 != wg0 && $1 != wg1 ) ]]; then usage >&2; exit 2; fi

# The root-owned directory makes this lock common to all cooperating users.
# Keep the lock for the entire state check, switch, and recovery.
code="$(declare -f fail state switch_profile)"$'\n''switch_profile "$1"'
if sudo flock -n -E 75 /run/lock/vpn-switch.lock bash -c "$code" vpn-switch "$1"; then
  exit 0
else
  status=$?
  if [[ $status == 75 ]]; then printf 'vpn-switch: another profile switch is running\n' >&2; fi
  exit "$status"
fi
