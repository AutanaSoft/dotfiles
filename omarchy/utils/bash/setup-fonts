#!/usr/bin/env bash
# Install pinned profile Nerd Fonts without taking ownership of existing files.
set -euo pipefail
SCRIPT_PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${DOTFILES_ROOT:-$(cd -- "$SCRIPT_PATH/.." && pwd)}"
DRY_RUN=0
FONT_BASE="${HOME}/.local/share/fonts"
MONASPACE_URL='https://github.com/githubnext/monaspace/releases/download/v1.400/monaspace-nerdfonts-v1.400.zip'
FIRACODE_URL='https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/FiraCode.zip'
FIRAMONO_URL='https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/FiraMono.zip'
MONASPACE_SHA='9b7f9505d977601d8819dfdb57fa4b49bdab61132b6d1131c2e8d092066edc5a'
FIRACODE_SHA='239395baf60c89b2eaf4862b6b09db0ef95605cd3e8eef51c00345822a81a665'
FIRAMONO_SHA='292f2f9160d76a6603a920d3813caa89233a9910d7eadf2832639ad1ddbf98b4'
usage() {
  cat <<EOF
Usage: $0 [--dry-run] [--help]

Installs version-pinned Nerd Fonts under $FONT_BASE/<family> and refreshes fontconfig.
Official SHA-256 values are pinned for Monaspace v1.400 and Nerd Fonts v3.5.1;
all archives are verified and staged before installation. Newly installed files
are tracked in $FONT_BASE/.dotfiles-fonts-ownership. Existing untracked or
modified files cause a safe stop; no files are adopted, overwritten, or pruned.
Older unmanaged files are preserved. --dry-run performs no downloads or writes.
EOF
}
while (($#)); do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --non-interactive) shift ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
log() { printf '[setup-fonts] %s\n' "$*"; }
fail() { printf '[setup-fonts] ERROR: %s\n' "$*" >&2; exit 1; }
labels=(MonaspaceNerdFont FiraCodeNerdFont FiraMonoNerdFont)
urls=("$MONASPACE_URL" "$FIRACODE_URL" "$FIRAMONO_URL")
hashes=("$MONASPACE_SHA" "$FIRACODE_SHA" "$FIRAMONO_SHA")
if ((DRY_RUN)); then
  log 'Mode: DRY-RUN (no downloads, writes, or fc-cache)'
  for i in "${!labels[@]}"; do
    log "[dry-run] would download pinned archive: ${urls[i]} (SHA-256 ${hashes[i]})"
    log "[dry-run] would verify, stage, and install ${labels[i]} under $FONT_BASE/${labels[i]}"
  done
  log "[dry-run] would run: fc-cache -f $FONT_BASE/.."
  exit 0
fi
for cmd in curl unzip sha256sum fc-cache; do command -v "$cmd" >/dev/null 2>&1 || fail "Required command '$cmd' is not on PATH."; done
workdir="$(mktemp -d)"
trap 'rm -rf -- "$workdir"' EXIT
mkdir -p "$workdir/stage"
record="$FONT_BASE/.dotfiles-fonts-ownership"
for component in "$HOME/.local" "$HOME/.local/share" "$FONT_BASE"; do
  [[ ! -L "$component" ]] || fail "Font destination path is a symlink; refusing to follow it: $component"
done
if [[ -e "$record" && ( ! -f "$record" || -L "$record" ) ]]; then fail "Ownership record is not a regular file: $record"; fi
# Download and validate every artifact before extracting or touching destinations.
for i in "${!labels[@]}"; do
  zip="$workdir/${labels[i]}.zip"
  log "Downloading ${labels[i]} from ${urls[i]}"
  curl -fL --retry 3 -o "$zip" "${urls[i]}" || fail "Download failed for ${labels[i]}: ${urls[i]}"
  result="$(sha256sum "$zip")" || fail "SHA-256 verification command failed for ${labels[i]}"
  actual="${result%% *}"
  [[ "$actual" == "${hashes[i]}" ]] || fail "SHA-256 mismatch for ${labels[i]} (expected ${hashes[i]}, got $actual)"
done
# Extract all artifacts and build a complete staged inventory.
for i in "${!labels[@]}"; do
  extract="$workdir/extract-${labels[i]}"
  mkdir -p "$extract"
  unzip -q "$workdir/${labels[i]}.zip" -d "$extract" || fail "Extraction failed for ${labels[i]}"
  count=0
  while IFS= read -r -d '' file; do
    rel="${labels[i]}/${file##*/}"
    [[ "$rel" != *$'\n'* && "$rel" != *$'\t'* ]] || fail "Unsupported font filename in ${labels[i]}"
    target="$workdir/stage/$rel"
    mkdir -p "${target%/*}"
    cp -- "$file" "$target"
    count=$((count + 1))
  done < <(find "$extract" -type f \( -iname '*.ttf' -o -iname '*.otf' \) -print0)
  ((count > 0)) || fail "No .ttf or .otf files found in ${labels[i]} archive"
done
# Validate every recorded file and every destination collision before applying any files.
declare -A owned=()
if [[ -f "$record" ]]; then
  while IFS=$'\t' read -r hash rel; do
    [[ "$hash" =~ ^[0-9a-f]{64}$ && -n "$rel" && "$rel" != /* && "$rel" != *'..'* ]] || fail "Invalid ownership record entry"
    [[ -z "${owned[$rel]+x}" ]] || fail "Duplicate ownership record entry: $rel"
    owned[$rel]="$hash"
    path="$FONT_BASE/$rel"
    [[ ! -L "$path" && -f "$path" ]] || fail "Managed font is missing or a symlink; refusing update: $path"
    current="$(sha256sum "$path")" || fail "Could not verify managed font: $path"
    [[ "${current%% *}" == "$hash" ]] || fail "Managed font was modified; refusing update: $path"
  done <"$record"
fi
while IFS= read -r -d '' staged; do
  rel="${staged#"$workdir/stage/"}"
  dest="$FONT_BASE/$rel"
  family="$FONT_BASE/${rel%%/*}"
  [[ ! -L "$family" ]] || fail "Font family destination is a symlink; refusing to follow it: $family"
  if [[ -e "$dest" || -L "$dest" ]]; then
    [[ -n "${owned[$rel]+x}" ]] || fail "Unmanaged font collision; preserving existing file: $dest"
    [[ ! -L "$dest" && -f "$dest" ]] || fail "Managed destination is not a regular file: $dest"
  fi
done < <(find "$workdir/stage" -type f -print0)
# Install only after all preflight checks; keep old managed files absent from this release.
mkdir -p "$FONT_BASE"
tmp_record="$workdir/ownership"
: >"$tmp_record"
while IFS= read -r -d '' staged; do
  rel="${staged#"$workdir/stage/"}"
  dest="$FONT_BASE/$rel"
  mkdir -p "${dest%/*}"
  cp -- "$staged" "$dest"
  hash="$(sha256sum "$dest")" || fail "Could not hash installed font: $dest"
  printf '%s\t%s\n' "${hash%% *}" "$rel" >>"$tmp_record"
done < <(find "$workdir/stage" -type f -print0 | sort -z)
cp -- "$tmp_record" "$record"
log 'Refreshing fontconfig cache'
fc-cache -f "$FONT_BASE/.."
log 'Setup complete.'
