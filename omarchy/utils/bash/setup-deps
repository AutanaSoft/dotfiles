#!/usr/bin/env bash

set -euo pipefail

SCRIPT_PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${DOTFILES_ROOT:-$(cd -- "$SCRIPT_PATH/../../.." && pwd)}"
DRY_RUN="${DOTFILES_DRY_RUN:-0}"
OMARCHY=0
MANIFEST="$REPO_ROOT/omarchy/deps-manifest"

usage() {
    cat <<EOF
Usage: $0 --omarchy [--dry-run] [--help]

Install the packages declared in the Omarchy dependency manifest in one yay
batch. The profile must be selected by the dispatcher or with --omarchy; this
helper never autodetects it.
EOF
}

log() { echo "[setup-deps] $*"; }
fail() { echo "[setup-deps] ERROR: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --omarchy) OMARCHY=1; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        --non-interactive) shift ;;
        --help|-h) usage; exit 0 ;;
        *) fail "unknown option: $1" ;;
    esac
done
(( OMARCHY )) || fail "--omarchy is required; select a profile explicitly"
[[ -f "$MANIFEST" ]] || fail "dependency manifest not found: $MANIFEST"

packages=()
declare -A seen=()
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]] && continue

    case "$line" in
        *$'\t'*$'\t'*) fail "malformed manifest line: $line" ;;
        *$'\t'*) ;;
        *) fail "malformed manifest line: $line" ;;
    esac

    IFS=$'\t' read -r action package <<< "$line"
    [[ "$action" == package ]] || fail "unknown manifest action: $action"
    [[ "$package" =~ ^[[:alnum:]@._+:-]+$ ]] || fail "malformed package name: $package"
    [[ -z "${seen[$package]+x}" ]] || fail "duplicate package in manifest: $package"
    seen["$package"]=1
    packages+=("$package")
done < "$MANIFEST"

((${#packages[@]} > 0)) || fail "dependency manifest contains no packages"

missing=()
for package in "${packages[@]}"; do
    if command -v pacman >/dev/null 2>&1 && pacman -Q "$package" >/dev/null 2>&1; then
        log "[installed] $package"
    else
        log "[missing] $package"
        missing+=("$package")
    fi
done

if ((${#missing[@]} == 0)); then
    log "All manifest packages are installed."
    exit 0
fi

if (( DRY_RUN )); then
    log "[dry-run] would run: yay -S --needed ${missing[*]}"
    exit 0
fi

command -v yay >/dev/null 2>&1 || fail "yay is not on PATH"
log "Installing missing packages in one batch"
yay -S --needed "${missing[@]}"
