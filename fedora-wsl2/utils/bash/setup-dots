#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=setup-common
source "$SCRIPT_DIR/setup-common"

REPO_ROOT="${DOTFILES_ROOT:-$(cd -- "$SCRIPT_DIR/../../.." && pwd)}"
BACKUP_DIR="${DOTFILES_BACKUP_DIR:-$REPO_ROOT/backup/$(date -u +%Y%m%dT%H%M%SZ)}"
DRY_RUN="${DOTFILES_DRY_RUN:-0}"
NON_INTERACTIVE=0
DNF_ARGS=()
MANIFEST="$REPO_ROOT/fedora-wsl2/dots-paths"
SOURCE_ROOT="$REPO_ROOT/fedora-wsl2/home"
OPENCODE_BIN="$HOME/.opencode/bin/opencode"

log() { echo "[setup-dots] $*"; }
fail() { echo "[setup-dots] ERROR: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --non-interactive) NON_INTERACTIVE=1; DNF_ARGS+=(--assumeyes); shift ;;
        *) fail "unknown option: $1" ;;
    esac
done

trim() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    printf '%s' "${value%"${value##*[![:space:]]}"}"
}

valid_relative_path() {
    [[ -n "$1" && "$1" != . && "$1" != /* && "$1" != .. && "$1" != ../* && "$1" != */.. && "$1" != */../* ]]
}

backup_target() {
    local target="$1" rel
    rel="${target#"$HOME"/}"
    printf '%s/%s\n' "$BACKUP_DIR" "$rel"
}

ensure_symlink() {
    local source="$1" target="$2" backup
    if [[ -L "$target" && "$(readlink -f -- "$target" 2>/dev/null || true)" == "$(readlink -f -- "$source")" ]]; then
        log "Already linked: $target"
        return
    fi
    if [[ -e "$target" || -L "$target" ]]; then
        backup="$(backup_target "$target")"
        log "Backing up: $target -> $backup"
        (( DRY_RUN )) || { mkdir -p "$(dirname -- "$backup")"; mv -- "$target" "$backup"; }
    fi
    log "Creating symlink: $target -> $source"
    (( DRY_RUN )) || { mkdir -p "$(dirname -- "$target")"; ln -s -- "$source" "$target"; }
}

apply_manifest() {
    local line source target extra
    [[ -f "$MANIFEST" ]] || fail "manifest not found: $MANIFEST"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]] && continue
        [[ "$line" != *'|'*'|'* ]] || fail "malformed manifest line: $line"
        IFS='|' read -r source target extra <<< "$line"
        source="$(trim "${source:-}")"
        target="$(trim "${target:-}")"
        [[ -z "${extra:-}" && "$line" == *'|'* ]] || fail "malformed manifest line: $line"
        valid_relative_path "$source" && valid_relative_path "$target" || fail "unsafe manifest path: $line"
        [[ -e "$SOURCE_ROOT/$source" || -L "$SOURCE_ROOT/$source" ]] || fail "source does not exist: $source"
        ensure_symlink "$SOURCE_ROOT/$source" "$HOME/$target"
    done < "$MANIFEST"
}

install_lazyvim() {
    local target="$HOME/.config/nvim"
    if [[ -e "$target" || -L "$target" ]]; then
        log "Keeping existing Neovim configuration: $target"
        return
    fi
    log "Installing LazyVim starter at $target"
    (( DRY_RUN )) && return
    command -v git >/dev/null 2>&1 || fail "git is required to install LazyVim"
    mkdir -p "$(dirname -- "$target")"
    git clone https://github.com/LazyVim/starter "$target"
    rm -rf -- "$target/.git"
}

rpm_mise_bin() {
    local mise_path package_name

    while IFS= read -r mise_path; do
        package_name="$(rpm -qf --qf '%{NAME}' "$mise_path" 2>/dev/null || true)"
        if [[ "$package_name" == mise ]]; then
            printf '%s\n' "$mise_path"
            return
        fi
    done < <(type -a -p mise 2>/dev/null || true)

    return 1
}

install_mise() {
    local mise_bin

    if mise_bin="$(rpm_mise_bin)"; then
        log "Mise is installed from RPM: $mise_bin"
        MISE_BIN="$mise_bin"
        return
    fi

    setup_require_command rpm
    setup_require_command dnf
    setup_preflight_privileged_phase "$DRY_RUN" "$NON_INTERACTIVE"

    if (( DRY_RUN )); then
        log "Installing DNF COPR support if needed"
    elif ! dnf copr --help >/dev/null 2>&1; then
        log "Installing DNF COPR support"
        sudo dnf "${DNF_ARGS[@]}" install dnf-plugins-core
    fi

    log "Enabling jdxcode/mise COPR"
    log "Installing Mise with DNF"
    (( DRY_RUN )) && return
    sudo dnf "${DNF_ARGS[@]}" copr enable jdxcode/mise
    sudo dnf "${DNF_ARGS[@]}" install mise
    MISE_BIN="$(rpm_mise_bin)" || fail "Mise installation did not provide an RPM-managed executable"
}

install_opencode() {
    if [[ -x "$OPENCODE_BIN" ]]; then
        log "OpenCode is installed: $OPENCODE_BIN"
        return
    fi
    log "Installing OpenCode at $OPENCODE_BIN"
    (( DRY_RUN )) && return
    command -v curl >/dev/null 2>&1 || fail "curl is required to install OpenCode"
    curl -fsSL https://opencode.ai/install | bash
    [[ -x "$OPENCODE_BIN" ]] || fail "OpenCode installation did not create $OPENCODE_BIN"
}

install_lazyvim
apply_manifest
install_mise
install_opencode
log "Installing tools declared by Mise"
if (( !DRY_RUN )); then
    [[ -n "${MISE_BIN:-}" ]] || fail "Mise installation did not provide an RPM-managed executable"
    "$MISE_BIN" install
fi
