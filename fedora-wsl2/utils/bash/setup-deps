#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="${DOTFILES_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)}"
DRY_RUN="${DOTFILES_DRY_RUN:-0}"
MANIFEST="$REPO_ROOT/fedora-wsl2/dnf-packages"
POSTGRES_DATA_DIR="/var/lib/pgsql/data"

log() { echo "[setup-deps] $*"; }
fail() { echo "[setup-deps] ERROR: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --non-interactive) shift ;;
        *) fail "unknown option: $1" ;;
    esac
done

read_packages() {
    local package
    declare -gA seen=()
    packages=()
    while IFS= read -r package || [[ -n "$package" ]]; do
        [[ "$package" =~ ^[[:space:]]*$ || "$package" =~ ^[[:space:]]*# ]] && continue
        [[ "$package" =~ ^[[:alnum:]@._+:-]+$ ]] || fail "malformed package name: $package"
        [[ -z "${seen[$package]+x}" ]] || fail "duplicate package: $package"
        seen["$package"]=1
        packages+=("$package")
    done < "$MANIFEST"
    ((${#packages[@]} > 0)) || fail "dependency manifest contains no packages"
}

ensure_service() {
    local service="$1"
    if systemctl is-enabled --quiet "$service"; then
        log "$service is enabled"
    else
        log "Enabling $service"
        (( DRY_RUN )) || sudo systemctl enable "$service"
    fi

    if systemctl is-active --quiet "$service"; then
        log "$service is running"
    else
        log "Starting $service"
        (( DRY_RUN )) || sudo systemctl start "$service"
    fi
}

[[ -f "$MANIFEST" ]] || fail "manifest not found: $MANIFEST"
command -v rpm >/dev/null 2>&1 || fail "rpm is required"
read_packages

missing=()
for package in "${packages[@]}"; do
    if rpm -q "$package" >/dev/null 2>&1; then
        log "[installed] $package"
    else
        log "[missing] $package"
        missing+=("$package")
    fi
done

if ((${#missing[@]})); then
    log "Installing missing packages: ${missing[*]}"
    (( DRY_RUN )) || { command -v dnf >/dev/null 2>&1 || fail "dnf is required"; sudo dnf install "${missing[@]}"; }
fi

if (( DRY_RUN )); then
    log "[dry-run] would initialize PostgreSQL if the cluster is absent"
elif sudo test -f "$POSTGRES_DATA_DIR/PG_VERSION"; then
    log "PostgreSQL cluster is initialized"
elif [[ -n "$(sudo find "$POSTGRES_DATA_DIR" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
        fail "PostgreSQL data directory is not empty and is missing PG_VERSION: $POSTGRES_DATA_DIR"
else
    log "Initializing PostgreSQL cluster"
    sudo postgresql-setup --initdb
fi

ensure_service postgresql
ensure_service valkey
