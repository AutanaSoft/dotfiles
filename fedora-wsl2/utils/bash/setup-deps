#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="${DOTFILES_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)}"
DRY_RUN="${DOTFILES_DRY_RUN:-0}"
MANIFEST="$REPO_ROOT/fedora-wsl2/dnf-packages"
CHROME_RPM_URL="https://dl.google.com/linux/direct/google-chrome-stable_current_x86_64.rpm"

log() { echo "[setup-deps] $*"; }
fail() { echo "[setup-deps] ERROR: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --non-interactive) shift ;;
        *) fail "unknown option: $1" ;;
    esac
done

read_dependencies() {
    local dependency
    declare -gA seen=()
    packages=()
    groups=()
    while IFS= read -r dependency || [[ -n "$dependency" ]]; do
        [[ "$dependency" =~ ^[[:space:]]*$ || "$dependency" =~ ^[[:space:]]*# ]] && continue
        [[ "$dependency" =~ ^@[[:alnum:]._+:-]+$ || "$dependency" =~ ^[[:alnum:]._+:-]+$ ]] || fail "malformed dependency: $dependency"
        [[ -z "${seen[$dependency]+x}" ]] || fail "duplicate dependency: $dependency"
        seen["$dependency"]=1
        if [[ "$dependency" == @* ]]; then
            groups+=("${dependency#@}")
        else
            packages+=("$dependency")
        fi
    done < "$MANIFEST"
    ((${#packages[@]} + ${#groups[@]} > 0)) || fail "dependency manifest contains no dependencies"
}

[[ -f "$MANIFEST" ]] || fail "manifest not found: $MANIFEST"
command -v rpm >/dev/null 2>&1 || fail "rpm is required"
command -v dnf >/dev/null 2>&1 || fail "dnf is required"
read_dependencies

missing_groups=()
for group in "${groups[@]}"; do
    group_info="$(dnf group info --installed "$group" 2>/dev/null || true)"
    if [[ "$group_info" == *"Id                   : $group"* ]]; then
        log "[installed] @$group"
    else
        log "[missing] @$group"
        missing_groups+=("$group")
    fi
done

if ((${#missing_groups[@]})); then
    log "Installing missing groups: ${missing_groups[*]}"
    (( DRY_RUN )) || sudo dnf group install "${missing_groups[@]}"
fi

missing_packages=()
for package in "${packages[@]}"; do
    if rpm -q "$package" >/dev/null 2>&1; then
        log "[installed] $package"
    else
        log "[missing] $package"
        missing_packages+=("$package")
    fi
done

if ((${#missing_packages[@]})); then
    log "Installing missing packages: ${missing_packages[*]}"
    (( DRY_RUN )) || sudo dnf install "${missing_packages[@]}"
fi

if rpm -q google-chrome-stable >/dev/null 2>&1; then
    log "[installed] google-chrome-stable"
else
    log "[missing] google-chrome-stable"
    log "Installing Google Chrome Stable from the official RPM"
    (( DRY_RUN )) || sudo dnf install "$CHROME_RPM_URL"
fi
