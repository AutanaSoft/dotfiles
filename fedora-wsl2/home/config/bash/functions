# Custom Bash functions.

# Create or attach the default development session when Tmux has no arguments.
tmux() {
  if (($# == 0)); then
    command tmux new-session -A -s AutanaSoft
  else
    command tmux "$@"
  fi
}

# Create a tmux development layout with editor, AI, and terminal panes.
# Usage: tdl <ai> [second_ai]
tdl() {
  local ai="${1:-}"
  local ai2="${2:-}"
  local current_dir="${PWD}"
  local editor_pane ai_pane ai2_pane launch_command session session_name="AutanaSoft"

  if [[ -z "$ai" ]]; then
    printf 'Usage: tdl <ai> [second_ai]\n' >&2
    return 1
  fi
  if ! command -v "$ai" >/dev/null 2>&1; then
    printf 'tdl: command not found: %s\n' "$ai" >&2
    return 1
  fi
  if [[ -n "$ai2" ]] && ! command -v "$ai2" >/dev/null 2>&1; then
    printf 'tdl: command not found: %s\n' "$ai2" >&2
    return 1
  fi
  if ! command -v tmux >/dev/null 2>&1; then
    printf 'tdl: command not found: tmux\n' >&2
    return 1
  fi
  if [[ -z "${TMUX:-}" || -z "${TMUX_PANE:-}" ]]; then
    if tmux has-session -t "$session_name" 2>/dev/null; then
      tmux attach-session -t "$session_name"
      return $?
    fi
    printf -v launch_command 'tdl %q' "$ai"
    if [[ -n "$ai2" ]]; then
      printf -v launch_command '%s %q' "$launch_command" "$ai2"
    fi
    session=$(tmux new-session -d -P -F '#{session_name}' -s "$session_name" -c "$current_dir") || return
    tmux send-keys -t "$session" "$launch_command" C-m || return
    tmux attach-session -t "$session"
    return $?
  fi

  [[ "$(tmux display-message -p '#S')" == "$session_name" ]] || {
    printf 'tdl: run this command inside the %s tmux session\n' "$session_name" >&2
    return 1
  }

  editor_pane="$TMUX_PANE"
  tmux rename-window -t "$editor_pane" "$(basename "$current_dir")" || return

  ai_pane=$(tmux split-window -h -p 35 -t "$editor_pane" -c "$current_dir" -P -F '#{pane_id}') || return
  tmux split-window -v -p 20 -t "$editor_pane" -c "$current_dir" || return

  if [[ -n "$ai2" ]]; then
    ai2_pane=$(tmux split-window -v -t "$ai_pane" -c "$current_dir" -P -F '#{pane_id}') || return
  fi

  sleep 1
  tmux send-keys -t "$editor_pane" "${EDITOR:-nvim} ." C-m
  tmux send-keys -t "$ai_pane" "$ai" C-m
  if [[ -n "$ai2" ]]; then
    tmux send-keys -t "$ai2_pane" "$ai2" C-m
  fi
  tmux select-pane -t "$ai_pane"
}

# Pick a recently modified file and copy it to a remote destination.
sff() {
  if (($# == 0)); then
    printf 'Usage: sff <destination> (e.g. sff host:/tmp/)\n' >&2
    return 1
  fi
  local file
  file=$(find . -type f -printf '%T@\t%p\n' | sort -rn | cut -f2- | ff) || return 1
  if [[ -n "$file" ]]; then
    scp "$file" "$1"
  fi
}

# Use regular cd for existing paths and Zoxide for remembered paths.
zd() {
  if (($# == 0)); then
    builtin cd ~ || return
  elif [[ -d $1 ]]; then
    builtin cd "$1" || return
  elif ! z "$@"; then
    printf 'Error: Directory not found\n' >&2
    return 1
  else
    printf '\U000F17A9 '
    pwd
  fi
}

# Open Windows-mounted paths with Explorer and other paths with xdg-open.
open() {
  if (($# == 0)); then
    printf 'open: missing argument\n' >&2
    return 1
  fi
  local target="$1"
  if [[ "$target" == /mnt/* ]] &&
    command -v wslpath >/dev/null 2>&1 &&
    command -v explorer.exe >/dev/null 2>&1; then
    local win_path
    if ! win_path=$(wslpath -w "$target"); then
      printf 'open: wslpath -w failed to convert %q\n' "$target" >&2
      return 1
    fi
    if [[ -z "$win_path" ]]; then
      printf 'open: wslpath -w produced empty path for %q\n' "$target" >&2
      return 1
    fi
    explorer.exe "$win_path"
    return $?
  fi
  if ! command -v xdg-open >/dev/null 2>&1; then
    printf 'open: xdg-open not available\n' >&2
    return 1
  fi
  xdg-open "$target"
}

n() {
  if (($# == 0)); then
    command nvim .
  else
    command nvim "$@"
  fi
}

__wezterm_osc7() {
  printf '\033]7;file://%s%s\033\\' "${HOSTNAME}" "${PWD}"
}
