#!/usr/bin/env bash
# Interactive interface for the public ./setup dispatcher.
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
[[ -t 0 && -t 1 && -r /dev/tty ]] || {
  printf '[setup-tui] An interactive terminal is required. Use ./setup --help for CLI options.\n' >&2
  exit 2
}

PROFILE=omarchy
DOTS=1
DEPS=0
FONTS=0
SERVICES=0
CONTAINERS=0
TIMEZONE=0
DRY_RUN=1
CURSOR=0
SCREEN=menu
MESSAGE=''

# Keep the input/output bound to the controlling terminal.
exec 3<>/dev/tty
cleanup() {
  printf '\033[?25h\033[?1049l' >&3
  exec 3>&-
}
trap cleanup EXIT
trap 'exit 130' INT TERM
printf '\033[?1049h\033[?25l' >&3

paint() { printf '%b' "$*" >&3; }
line() { printf '%s\n' "$*" >&3; }
options() {
  KEYS=(profile dots deps)
  if [[ $PROFILE == omarchy ]]; then
    KEYS+=(fonts services)
  else
    KEYS+=(containers timezone)
  fi
  KEYS+=(dry-run continue cancel)
}
value() {
  case "$1" in
    profile) printf '%s' "$PROFILE" ;;
    dots) printf '%s' "$DOTS" ;;
    deps) printf '%s' "$DEPS" ;;
    fonts) printf '%s' "$FONTS" ;;
    services) printf '%s' "$SERVICES" ;;
    containers) printf '%s' "$CONTAINERS" ;;
    timezone) printf '%s' "$TIMEZONE" ;;
    dry-run) printf '%s' "$DRY_RUN" ;;
  esac
}
label() {
  case "$1" in
    profile) printf 'Profile                 %s' "$PROFILE" ;;
    dots) printf 'Apply dotfiles' ;;
    deps) printf 'Install dependencies' ;;
    fonts) printf 'Install user fonts' ;;
    services) printf 'Configure services' ;;
    containers) printf 'Install Docker Engine' ;;
    timezone) printf 'Set system time zone' ;;
    dry-run) printf 'Preview only (no changes)' ;;
    continue) printf 'Review selection' ;;
    cancel) printf 'Cancel' ;;
  esac
}
render_item() {
  local key="$1" index="$2" prefix='  ' suffix=''
  (( index == CURSOR )) && prefix='❯ '
  case "$key" in
    dots|deps|fonts|services|containers|timezone|dry-run)
      if [[ $(value "$key") == 1 ]]; then suffix='[x] ' ; else suffix='[ ] ' ; fi ;;
  esac
  if (( index == CURSOR )); then
    paint '\033[48;5;60m\033[97m'
  fi
  printf '  %s%s%s\033[0m\n' "$prefix" "$suffix" "$(label "$key")" >&3
}
render_menu() {
  options
  paint '\033[H\033[2J'
  paint '\033[1;36m  DOTFILES SETUP\033[0m    Interactive installer\n'
  line '  ─────────────────────────────────────────────────────'
  line '  Select a profile and the actions to perform.'
  line '  Existing files are backed up by the profile helpers.'
  line ''
  local i
  for i in "${!KEYS[@]}"; do
    case "${KEYS[i]}" in
      profile) paint '\n\033[1;35m  PROFILE\033[0m\n' ;;
      dots) paint '\n\033[1;35m  USER CONFIGURATION\033[0m\n' ;;
      deps) paint '\n\033[1;35m  OPTIONAL PHASES\033[0m\n' ;;
      dry-run) paint '\n\033[1;35m  EXECUTION\033[0m\n' ;;
      continue) paint '\n\033[1;35m  ACTIONS\033[0m\n' ;;
    esac
    render_item "${KEYS[i]}" "$i"
  done
  line ''
  paint '\033[90m  ↑/↓ or j/k navigate · space toggle · enter select · esc quit\033[0m\n'
  [[ -z $MESSAGE ]] || { paint '\033[33m'; line "  $MESSAGE"; paint '\033[0m'; }
}

build_args() {
  ARGS=(--profile "$PROFILE" --non-interactive)
  if (( DOTS )); then
    if (( DEPS || FONTS || SERVICES || CONTAINERS || TIMEZONE )); then
      ARGS+=(--dots)
    else
      ARGS+=(--dots-only)
    fi
  fi
  (( DEPS )) && ARGS+=(--deps)
  (( FONTS )) && ARGS+=(--fonts)
  (( SERVICES )) && ARGS+=(--services)
  (( CONTAINERS )) && ARGS+=(--containers)
  (( TIMEZONE )) && ARGS+=(--timezone)
  (( DRY_RUN )) && ARGS+=(--dry-run)
}
render_review() {
  paint '\033[H\033[2J'
  paint '\033[1;36m  REVIEW SETUP\033[0m\n'
  line '  ─────────────────────────────────────────────────────'
  line "  Profile:     $PROFILE"
  if (( DRY_RUN )); then
    line '  Mode:        Preview (read-only)'
  else
    paint '\033[1;33m  Mode:        APPLY CHANGES TO THIS MACHINE\033[0m\n'
  fi
  line ''
  local phase
  for phase in dots deps fonts containers services timezone; do
    if [[ $(value "$phase") == 1 ]]; then
      line "  [x] $(label "$phase")"
    fi
  done
  line ''
  line '  Command:'
  printf '    ./setup' >&3
  printf ' %q' "${ARGS[@]}" >&3
  printf '\n\n' >&3
  paint '\033[90m  Enter confirm · b back · esc cancel\033[0m\n'
  if (( !DRY_RUN )); then
    paint '\033[33m  Package, service and system changes may require sudo.\033[0m\n'
  fi
}
read_key() {
  local first second third
  IFS= read -rsn1 first <&3 || return 1
  if [[ $first == $'\e' ]]; then
    # Read an ANSI arrow sequence without blocking on a lone Escape.
    if IFS= read -rsn1 -t 0.08 second <&3 && [[ $second == '[' ]]; then
      IFS= read -rsn1 -t 0.08 third <&3 || true
      case "$third" in A) KEY=up ;; B) KEY=down ;; *) KEY=escape ;; esac
    else
      KEY=escape
    fi
  elif [[ -z $first ]]; then
    KEY=enter
  elif [[ $first == ' ' ]]; then
    KEY=space
  else
    KEY=$first
  fi
}
activate() {
  local key=${KEYS[CURSOR]}
  MESSAGE=''
  case "$key" in
    profile)
      if [[ $PROFILE == omarchy ]]; then PROFILE=fedora-wsl2; else PROFILE=omarchy; fi
      FONTS=0; SERVICES=0; CONTAINERS=0; TIMEZONE=0
      ;;
    dots) DOTS=$((1-DOTS)) ;;
    deps) DEPS=$((1-DEPS)) ;;
    fonts) FONTS=$((1-FONTS)) ;;
    services) SERVICES=$((1-SERVICES)) ;;
    containers) CONTAINERS=$((1-CONTAINERS)) ;;
    timezone) TIMEZONE=$((1-TIMEZONE)) ;;
    dry-run) DRY_RUN=$((1-DRY_RUN)) ;;
    cancel) exit 0 ;;
    continue)
      if (( !DOTS && !DEPS && !FONTS && !SERVICES && !CONTAINERS && !TIMEZONE )); then
        MESSAGE='Select at least one phase.'
      else
        build_args
        SCREEN=review
      fi
      ;;
  esac
}

while :; do
  if [[ $SCREEN == menu ]]; then render_menu; else render_review; fi
  read_key || exit 1
  if [[ $SCREEN == review ]]; then
    case "$KEY" in
      escape) exit 0 ;;
      b|B) SCREEN=menu ;;
      enter)
        # Restore the original terminal before handing control to the installer.
        cleanup
        trap - EXIT INT TERM
        exec "$ROOT_DIR/setup" "${ARGS[@]}"
        ;;
    esac
    continue
  fi
  case "$KEY" in
    escape|q) exit 0 ;;
    up|k) (( CURSOR > 0 )) && CURSOR=$((CURSOR-1)) || true ;;
    down|j) (( CURSOR < ${#KEYS[@]}-1 )) && CURSOR=$((CURSOR+1)) || true ;;
    enter|space) activate ;;
  esac
done
