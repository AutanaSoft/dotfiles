#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BACKUP_DIR="$SCRIPT_DIR/backup/$(date -u +%Y%m%dT%H%M%SZ)"

PROFILE=""
DOTS=0
DOTS_ONLY=0
DEPS=0
FONTS=0
SERVICES=0
LOCALE=0
NO_VALIDATE=0
NON_INTERACTIVE=0
DRY_RUN=0

usage() {
    cat <<EOF
Usage: $0 [--profile omarchy|fedora-wsl2] [--dots | --dots-only] [phases] [options]

Configure the selected dotfiles profile.

Actions:
  --dots             Apply user dotfiles and, interactively, select optional phases.
  --dots-only        Apply only the manifest and permitted user copies.
  --deps             Run the selected profile dependency phase.
  --fonts            Install Omarchy user-local fonts.
  --services         Configure Omarchy keyd and ratbagd services.
  --locale           Install the Omarchy locale.

Options:
  --profile NAME     Select omarchy or fedora-wsl2.
  --no-validate      Skip final validation for --dots.
  --non-interactive  Disable profile and phase prompts.
  --dry-run          Print actions without mutating the host.
  --help, -h         Show this help.

Examples:
  $0 --dots
  $0 --profile omarchy --dots-only --dry-run
  $0 --profile omarchy --dots --deps --fonts --services --locale
  $0 --profile fedora-wsl2 --dots --deps
EOF
}

fail() {
    echo "[setup] ERROR: $*" >&2
    exit 2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile)
            [[ $# -ge 2 ]] || fail "--profile requires a value."
            PROFILE="$2"
            shift 2
            ;;
        --dots) DOTS=1; shift ;;
        --dots-only) DOTS_ONLY=1; shift ;;
        --deps) DEPS=1; shift ;;
        --fonts) FONTS=1; shift ;;
        --services) SERVICES=1; shift ;;
        --locale) LOCALE=1; shift ;;
        --no-validate) NO_VALIDATE=1; shift ;;
        --non-interactive) NON_INTERACTIVE=1; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) fail "unknown option: $1" ;;
    esac
done

if (( DOTS && DOTS_ONLY )); then
    fail "--dots and --dots-only cannot be combined."
fi
if (( DOTS_ONLY && (DEPS || FONTS || SERVICES || LOCALE || NO_VALIDATE) )); then
    fail "--dots-only cannot be combined with phases or --no-validate."
fi
if (( NO_VALIDATE && !DOTS )); then
    fail "--no-validate requires --dots."
fi
if (( NON_INTERACTIVE )) && [[ -z "$PROFILE" ]]; then
    fail "--non-interactive requires an explicit --profile."
fi

if [[ -z "$PROFILE" ]]; then
    if (( NON_INTERACTIVE )); then
        fail "a profile is required in non-interactive mode."
    fi
    printf 'Select a profile:\n  1) omarchy\n  2) fedora-wsl2\nChoice [1]: '
    if ! read -r choice; then
        fail "profile selection cancelled."
    fi
    case "$choice" in
        ""|1|omarchy) PROFILE=omarchy ;;
        2|fedora-wsl2) PROFILE=fedora-wsl2 ;;
        *) fail "invalid profile selection." ;;
    esac
fi
case "$PROFILE" in
    omarchy|fedora-wsl2) ;;
    *) fail "unsupported profile: $PROFILE" ;;
esac

if [[ "$PROFILE" == fedora-wsl2 ]] && (( FONTS || SERVICES || LOCALE || NO_VALIDATE )); then
    fail "--fonts, --services, --locale, and --no-validate are unsupported for fedora-wsl2."
fi

if (( !DOTS && !DOTS_ONLY && !DEPS && !FONTS && !SERVICES && !LOCALE )); then
    fail "choose --dots, --dots-only, or at least one phase."
fi

if (( DOTS )); then
    if (( !NON_INTERACTIVE )); then
        phases=(deps fonts services locale)
        [[ "$PROFILE" == fedora-wsl2 ]] && phases=(deps)
        for phase in "${phases[@]}"; do
            case "$phase" in
                deps) selected=$DEPS ;;
                fonts) selected=$FONTS ;;
                services) selected=$SERVICES ;;
                locale) selected=$LOCALE ;;
            esac
            if (( !selected )); then
                case "$phase" in
                    deps) prompt="Run dependencies? This may use the package manager, network, and install packages. [y/N] " ;;
                    fonts) prompt="Run fonts? This uses the network and downloads font archives. [y/N] " ;;
                    services) prompt="Run services? This uses sudo, overwrites/backups keyd configuration, and enables/reloads keyd/ratbagd. [y/N] " ;;
                    locale) prompt="Run locale? This writes /etc/locale.conf and may require sudo. [y/N] " ;;
                esac
                read -r -p "$prompt" answer || answer=""
                case "$answer" in
                    y|Y|yes|YES) case "$phase" in
                        deps) DEPS=1 ;; fonts) FONTS=1 ;; services) SERVICES=1 ;; locale) LOCALE=1 ;;
                    esac ;;
                esac
            fi
        done
    fi
fi

export DOTFILES_ROOT="$SCRIPT_DIR"
export DOTFILES_BACKUP_DIR="$BACKUP_DIR"
export DOTFILES_PROFILE="$PROFILE"
export DOTFILES_DRY_RUN=0
(( DRY_RUN )) && export DOTFILES_DRY_RUN=1

cleanup() {
    unset DOTFILES_ROOT DOTFILES_BACKUP_DIR DOTFILES_PROFILE DOTFILES_DRY_RUN
}
trap cleanup EXIT

args=(--profile "$PROFILE")
(( DOTS )) && args+=(--dots)
(( DOTS_ONLY )) && args+=(--dots-only)
(( DEPS )) && args+=(--deps)
(( FONTS )) && args+=(--fonts)
(( SERVICES )) && args+=(--services)
(( LOCALE )) && args+=(--locale)
(( DOTS && !NO_VALIDATE )) && args+=(--final-validation)
(( DRY_RUN )) && args+=(--dry-run)
(( NON_INTERACTIVE )) && args+=(--non-interactive)

case "$PROFILE" in
    omarchy) target="$SCRIPT_DIR/omarchy/utils/bash/setup-omarchy" ;;
    fedora-wsl2) target="$SCRIPT_DIR/fedora-wsl2/utils/bash/setup-fedora-wsl2" ;;
esac
[[ -x "$target" ]] || fail "profile helper is missing or not executable: $target"
"$target" "${args[@]}"
